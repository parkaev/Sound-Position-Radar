<Window x:Class="SoundRadar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Position Radar"
        Height="700" Width="1280" MinWidth="1040" MinHeight="620"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        Closing="OnWindowClosing" PreviewKeyDown="OnWindowPreviewKeyDown">
    <!-- Стили контролов — общие, лежат в App.Resources (App.xaml). -->
    <Grid>
        <Grid x:Name="mainHost">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" MinWidth="380" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition x:Name="colLog" Width="290" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- Колонка 1: настройки + мини-футер в самом низу -->
        <Grid Grid.Column="0" Margin="10,10,6,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2,0,8,4">
                    <GroupBox Header="Источник звука">
                        <StackPanel>
                            <RadioButton x:Name="rbProcess" Content="Звук конкретного процесса" IsChecked="True" GroupName="src" />
                            <RadioButton x:Name="rbDevice" Content="Всё выходное устройство" GroupName="src" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox x:Name="cbProcess" Width="210" />
                                <Button x:Name="btnRefresh" Content="⟳" Width="32" Margin="6,0,0,0" Click="OnRefreshProcesses"
                                        ToolTip="Обновить список процессов" />
                            </StackPanel>
                            <CheckBox x:Name="cbIncludeTree" Content="Включая дочерние процессы (лаунчеры)" IsChecked="True" Margin="0,10,0,0" />
                            <CheckBox x:Name="cb360" Content="360°: захват 8 каналов (7.1)" Margin="0,8,0,0"
                                      Checked="On360ModeChanged" Unchecked="On360ModeChanged"
                                      ToolTip="Если игра рендерит surround-микс — увидим зад (полный круг). Без него радар — фронтальный полукруг. Если система не отдаёт 8 каналов, автоматический откат на стерео." />
                            <TextBlock Text="Совет: в списке сверху процессы, которые сейчас воспроизводят звук."
                                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Детектор" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Профиль игры:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbProfile" Width="150" SelectionChanged="OnProfileChanged"
                                          ToolTip="DayZ: узкий пан (замерено по записям), направление по басовым полосам, вч-щелчок пули детектируется охотнее. Универсальный: constant-power.">
                                    <ComboBoxItem>DayZ</ComboBoxItem>
                                    <ComboBoxItem>Универсальный</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="tbThreshold" Text="Порог над фоном: 9.0 дБ" Foreground="{DynamicResource Brush.Text}"
                                       ToolTip="Насколько громче постоянного фона игры должен быть звук, чтобы стать событием. Ниже — больше событий и ложных срабатываний (ветер, птицы); выше — только очень явные звуки. Начните с 8–10: если оверлей мигает без причины — поднимите." />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Slider x:Name="slThreshold" Minimum="4" Maximum="20" Value="9" TickFrequency="1" Width="230"
                                        IsSnapToTickEnabled="True" ValueChanged="OnDetectorSliderChanged" />
                                <TextBox x:Name="tbThresholdValue" Width="52" Margin="6,0,0,0" TextChanged="OnDetectorTextChanged"
                                         PreviewTextInput="NumericOnly" MaxLength="3" />
                            </StackPanel>
                            <TextBlock x:Name="tbMinSalience" Text="Мин. громкость события: 6.0 дБ" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Brush.Text}"
                                       ToolTip="Фильтр показа: события слабее этого уровня не отображаются в оверлее и логе. Меньше — видны тихие и дальние звуки; больше — только близкие и громкие. Не то же самое, что порог: порог решает «обнаружить ли звук», этот фильтр — «показывать ли его»." />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Slider x:Name="slMinSalience" Minimum="3" Maximum="15" Value="6" TickFrequency="1" Width="230"
                                        IsSnapToTickEnabled="True" ValueChanged="OnDetectorSliderChanged" />
                                <TextBox x:Name="tbSalienceValue" Width="52" Margin="6,0,0,0" TextChanged="OnDetectorTextChanged"
                                         PreviewTextInput="NumericOnly" MaxLength="2" />
                            </StackPanel>
                            <CheckBox x:Name="cbShowLog" Content="Показывать журнал событий (правая колонка)"
                                      IsChecked="True" Checked="OnShowLogChanged" Unchecked="OnShowLogChanged" Margin="0,10,0,0"
                                      ToolTip="Выключите, чтобы убрать колонку «События» — центральная секция расширится." />
                            <CheckBox x:Name="cbJsonl" Content="Журнал событий JSONL (файл)" Margin="0,4,0,0" />
                            <CheckBox x:Name="cbWav" Content="Запись сырого WAV (диагностика)" Margin="0,4,0,0" />
                            <Button x:Name="btnResetDetector" Content="Сбросить настройки детектора" Margin="0,10,0,0"
                                    Click="OnResetDetector" ToolTip="Порог 9 дБ, мин. громкость 6 дБ (профиль игры не сбрасывается)" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Оверлей" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Вид:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbOverlayPreset" Width="160" SelectionChanged="OnOverlayPresetChanged">
                                    <ComboBoxItem>Дуги</ComboBoxItem>
                                    <ComboBoxItem>Свечение краёв</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Хоткей вкл/выкл:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="tbHotkey" Width="110" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown"
                                         GotKeyboardFocus="OnHotkeyGotFocus" LostKeyboardFocus="OnHotkeyLostFocus"
                                         Text="наж. для установки" Cursor="Hand" ToolTip="Кликните и нажмите сочетание (работает глобально, поверх игры)" />
                                <Button x:Name="btnHotkeyReset" Content="Сброс" Margin="6,0,0,0" Click="OnHotkeyReset"
                                        ToolTip="Сбросить хоткей" />
                            </StackPanel>
                            <TextBlock x:Name="hintHotkey" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Зон по кругу:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbZones" Width="76" SelectionChanged="OnZonesChanged">
                                    <ComboBoxItem>8</ComboBoxItem>
                                    <ComboBoxItem>12</ComboBoxItem>
                                    <ComboBoxItem IsSelected="True">16</ComboBoxItem>
                                    <ComboBoxItem>24</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Цвет:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbColorMode" Width="200" SelectionChanged="OnColorModeChanged"
                                          ToolTip="По близости: зеленоватый — звук дальше, красный/тёмно-красный — очень близко. По громкости: классическая шкала. Постоянный: один выбранный оттенок.">
                                    <ComboBoxItem>По близости</ComboBoxItem>
                                    <ComboBoxItem>По громкости</ComboBoxItem>
                                    <ComboBoxItem>Постоянный</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Оттенок:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="cbTintColor" Width="110" SelectionChanged="OnTintColorChanged" IsEnabled="False">
                                    <ComboBoxItem>Красный</ComboBoxItem>
                                    <ComboBoxItem>Оранжевый</ComboBoxItem>
                                    <ComboBoxItem>Жёлтый</ComboBoxItem>
                                    <ComboBoxItem>Голубой</ComboBoxItem>
                                    <ComboBoxItem>Белый</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Тонкая настройка (шаг 1, можно вписать вручную)" Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,2" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Непрозрачность, %:" Width="112" VerticalAlignment="Center" FontSize="12"
                                           ToolTip="Общая непрозрачность меток оверлея" />
                                <Slider x:Name="slOpacity" Minimum="30" Maximum="100" Value="85" Width="120"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnOverlaySliderChanged"
                                        ToolTip="Общая непрозрачность меток оверлея" />
                                <TextBox x:Name="tbOpacityValue" Width="52" Margin="6,0,0,0" TextChanged="OnOverlayTextChanged"
                                         PreviewTextInput="NumericOnly" MaxLength="3" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Размер от края, px:" Width="112" VerticalAlignment="Center" FontSize="12"
                                           ToolTip="Насколько глубоко свечение заходит от края экрана (пресет «Свечение краёв»); для «Дуг» — близость дуг к краю" />
                                <Slider x:Name="slSize" Minimum="60" Maximum="220" Value="130" Width="120"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnOverlaySliderChanged"
                                        ToolTip="Насколько глубоко свечение заходит от края экрана (пресет «Свечение краёв»); для «Дуг» — близость дуг к краю" />
                                <TextBox x:Name="tbSizeValue" Width="52" Margin="6,0,0,0" TextChanged="OnOverlayTextChanged"
                                         PreviewTextInput="NumericOnly" MaxLength="3" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Ширина реакции, °:" Width="112" VerticalAlignment="Center" FontSize="12"
                                           ToolTip="Угловая ширина сегмента, который подсвечивается одним событием" />
                                <Slider x:Name="slHalfWidth" Minimum="8" Maximum="30" Value="16" Width="120"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnOverlaySliderChanged"
                                        ToolTip="Угловая ширина сегмента, который подсвечивается одним событием" />
                                <TextBox x:Name="tbHalfWidthValue" Width="52" Margin="6,0,0,0" TextChanged="OnOverlayTextChanged"
                                         PreviewTextInput="NumericOnly" MaxLength="2" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Затухание, с:" Width="112" VerticalAlignment="Center" FontSize="12"
                                           ToolTip="За сколько секунд метка гаснет после конца события" />
                                <Slider x:Name="slFade" Minimum="1" Maximum="3" Value="1" Width="120"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnOverlaySliderChanged"
                                        ToolTip="За сколько секунд метка гаснет после конца события" />
                                <TextBox x:Name="tbFadeValue" Width="52" Margin="6,0,0,0" TextChanged="OnOverlayTextChanged"
                                         PreviewTextInput="NumericOnly" MaxLength="1" />
                            </StackPanel>
                            <TextBlock Text="Скрытые зоны (0 = перед):" Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,2" />
                            <WrapPanel x:Name="hiddenZonesPanel" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="btnPreview" Content="Предпросмотр оверлея" Click="OnPreviewOverlay"
                                        ToolTip="Показать оверлей с тестовыми метками по всем зонам — проверить настройки без игры" />
                                <Button x:Name="btnResetOverlay" Content="Сбросить настройки оверлея" Margin="8,0,0,0" Click="OnResetOverlay"
                                        ToolTip="Вернуть вид, цвет, зоны и затухание к значениям по умолчанию (хоткей не сбрасывается)" />
                            </StackPanel>
                            <TextBlock Text="Дуги: дуга зоны + тонкая метка точного азимута. Свечение краёв: плавная подсветка кромки. Работает в оконном режиме и «окно без рамки»; в полноэкранном исключительном оверлей не виден."
                                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Мини-футер: тема, справка, версия -->
            <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,7">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Тема:" VerticalAlignment="Center" Margin="2,0,6,0"
                                   Foreground="{DynamicResource Brush.Muted}" />
                        <ComboBox x:Name="cbTheme" Width="110" SelectionChanged="OnThemeChanged">
                            <ComboBoxItem>Системная</ComboBoxItem>
                            <ComboBoxItem>Тёмная</ComboBoxItem>
                            <ComboBoxItem>Светлая</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="btnHelp" Content="Справка" Padding="9,4" Click="OnHelpClick"
                                ToolTip="Описание всех настроек" />
                        <TextBlock x:Name="tbVersion" Margin="12,2,2,0" VerticalAlignment="Center" Cursor="Hand"
                                   MouseLeftButtonUp="OnVersionClick" Foreground="{DynamicResource Brush.Accent}"
                                   TextDecorations="Underline" Text="v0.0.0"
                                   ToolTip="Проверить обновления" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Колонка 2: радар + полосы + кнопки пуска -->
        <Grid Grid.Column="1" Margin="6,10,6,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="{x:Null}">
                <DockPanel>
                    <TextBlock x:Name="tbRadarMode" DockPanel.Dock="Bottom" Margin="2,6,2,2" FontSize="11"
                               Foreground="{DynamicResource Brush.Muted}"
                               Text="Режим (180°/360°) определяется по наличию задних каналов в миксе." />
                    <Border Background="{DynamicResource Brush.RadarBg}" CornerRadius="8"
                            BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1">
                        <Canvas x:Name="radar" SizeChanged="OnRadarSizeChanged" Background="Transparent" />
                    </Border>
                </DockPanel>
            </GroupBox>
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="Полосы: L/R превышение над фоном, дБ">
                    <StackPanel x:Name="metersPanel" Margin="2,2,2,2" />
                </GroupBox>
                <StackPanel Grid.Column="1" Width="170" Margin="10,0,0,0">
                    <Button x:Name="btnStart" Height="44" Click="OnStartStop"
                            Background="{DynamicResource Brush.StartBg}" Foreground="White" Content="▶  Старт" FontSize="15" FontWeight="Bold" />
                    <Button x:Name="btnOverlayToggle" Height="40" Margin="0,8,0,0" Click="OnOverlayToggle"
                            Content="Оверлей: ВЫКЛ" Foreground="White" FontSize="14" FontWeight="SemiBold"
                            ToolTip="Включить/выключить оверлей поверх игр (также глобальный хоткей)" />
                    <TextBlock x:Name="tbStatus" TextWrapping="Wrap" Margin="2,10,0,0"
                               Foreground="{DynamicResource Brush.Muted}" FontSize="11" MinHeight="40" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Колонка 3: журнал событий -->
        <Grid Grid.Column="2" x:Name="rightPanel" Margin="6,10,10,10">
            <GroupBox Header="События">
                <ListBox x:Name="lbEvents" FontFamily="Consolas" FontSize="12" BorderThickness="0" />
            </GroupBox>
        </Grid>

        <!-- Тост обновлений: плавает поверх контента, ничего не сдвигает -->
        <Border x:Name="updateBar" Grid.Column="1" Grid.ColumnSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                MaxWidth="500" CornerRadius="10" Padding="14,10" Visibility="Collapsed"
                Background="{DynamicResource Brush.PopupBg}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                Effect="{StaticResource ShadowPopup}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="tbUpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="btnUpdateDownload" Content="Открыть загрузку" Margin="14,0,0,0" Padding="9,4" Click="OnUpdateDownload" />
                <Button x:Name="btnUpdateSkip" Content="Не показывать снова" Margin="8,0,0,0" Padding="9,4" Click="OnUpdateSkip"
                        ToolTip="Скрывать это напоминание до выхода следующей версии" />
            </StackPanel>
        </Border>
        </Grid>

        <!-- Слой справки: панель поверх размытого основного окна, вместо отдельного окна -->
        <Grid x:Name="helpOverlay" Visibility="Collapsed" Background="{DynamicResource Brush.Scrim}">
            <Border Margin="60,36" Background="{DynamicResource Brush.Window}"
                    BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" CornerRadius="14"
                    Effect="{StaticResource ShadowPopup}">
                <Grid Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="btnHelpClose" DockPanel.Dock="Right" Content="✕" Width="32" Height="26"
                                Padding="0" Click="OnHelpClose" ToolTip="Закрыть справку (Esc)" />
                        <TextBlock Text="Справка" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="helpHost" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Hyperlink NavigateUri="https://github.com/parkaev" RequestNavigate="OnAuthorNavigate"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   ToolTip="Открыть профиль автора на GitHub">parkaev</Hyperlink>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
